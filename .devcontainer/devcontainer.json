{
  "name": "Shep CLI",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "mounts": [
    "source=shep-node-modules,target=/workspace/node_modules,type=volume",
    "source=shep-core-node-modules,target=/workspace/packages/core/node_modules,type=volume",
    "source=shep-electron-node-modules,target=/workspace/packages/electron/node_modules,type=volume",
    "source=shep-web-node-modules,target=/workspace/src/presentation/web/node_modules,type=volume",
    "source=shep-pnpm-store,target=/pnpm/store,type=volume"
  ],
  "containerEnv": {
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0",
    "PNPM_HOME": "/pnpm",
    "PNPM_STORE_DIR": "/pnpm/store",
    "PATH": "/pnpm:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
  },
  "remoteUser": "node",
  "postCreateCommand": "sudo mkdir -p /workspace/node_modules /workspace/packages/core/node_modules /workspace/packages/electron/node_modules /workspace/src/presentation/web/node_modules /pnpm/store && sudo chown -R node:node /workspace/node_modules /workspace/packages/core/node_modules /workspace/packages/electron/node_modules /workspace/src/presentation/web/node_modules /pnpm /workspace/.pnpm-store && pnpm install --frozen-lockfile --force",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-vscode.vscode-typescript-next"
      ]
    }
  }
}
